From afacf057c42e48e0b54f913d437f921798a9e97c Mon Sep 17 00:00:00 2001
From: Izan Rodriguez <izan@gastecom.es>
Date: Thu, 15 Oct 2026 09:31:45 +0200
Subject: [PATCH] Gastecom: secretos fuera del log y nombre de contactos LDAP

- belle-sip channel.c: censura en make_logbuf el valor de passwd/ha1/password
  del XML de aprovisionamiento y el token de /config/<token>.
- liblinphone xml2lpc.c / lpc2xml.c: "***" en las lineas "Set seccion|clave"
  de passwd, password, ha1 y config-uri (y sin dumpContent de esos valores).
- ldap-contact-provider.cpp: Friend::create(core) + setName() en vez de pasar
  el nombre del contacto como URI SIP (bug de Belledonne, 2026-08-19).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 belle-sip/src/channel.c                       | 31 +++++++++++++++++++
 liblinphone/coreapi/lpc2xml.c                 |  7 ++++-
 liblinphone/coreapi/xml2lpc.c                 | 19 ++++++++++--
 .../src/ldap/ldap-contact-provider.cpp        |  8 ++++-
 4 files changed, 60 insertions(+), 5 deletions(-)

diff --git a/belle-sip/src/channel.c b/belle-sip/src/channel.c
index 00246a1637..5add513792 100644
--- a/belle-sip/src/channel.c
+++ b/belle-sip/src/channel.c
@@ -1250,6 +1250,36 @@ static size_t find_non_printable(const char *buffer, size_t size) {
 	return i;
 #endif
 }
+/*
+ * Gastecom (2026-10-14): censura en el sitio (misma longitud) de secretos en
+ * los mensajes que se vuelcan al log. El aprovisionamiento remoto viaja por
+ * este canal (HTTPS): la peticion lleva el token de /config/<token> y la
+ * respuesta el XML con la contrasena SIP (passwd/ha1) y la de la agenda LDAP
+ * (password). Sin esto quedaban en claro en el log en cada arranque.
+ */
+static void gastecom_mask_after(char *buf, const char *needle, char stop) {
+	char *p = buf;
+	while ((p = strstr(p, needle)) != NULL) {
+		p += strlen(needle);
+		if (stop == '<') { /* valor de un <entry name="...">VALOR</entry> */
+			char *gt = strchr(p, '>');
+			if (!gt) return;
+			p = gt + 1;
+		}
+		for (; *p && *p != stop && *p != '<' && *p != ' ' && *p != '\r' && *p != '\n' && *p != '"' &&
+		       *p != '?' && *p != '&';
+		     ++p)
+			*p = '*';
+	}
+}
+
+static void gastecom_redact_logbuf(char *buf) {
+	gastecom_mask_after(buf, "name=\"passwd\"", '<');
+	gastecom_mask_after(buf, "name=\"ha1\"", '<');
+	gastecom_mask_after(buf, "name=\"password\"", '<');
+	gastecom_mask_after(buf, "/config/", ' ');
+}
+
 /*
  * this function is to avoid logging too much or non-ascii data received.
  */
@@ -1291,6 +1321,7 @@ static char *make_logbuf(belle_sip_channel_t *obj,
 		strcpy(logbuf + limit, truncate_msg);
 	}
 	logbuf[size] = '\0';
+	gastecom_redact_logbuf(logbuf);
 	return logbuf;
 }
 
diff --git a/liblinphone/coreapi/lpc2xml.c b/liblinphone/coreapi/lpc2xml.c
index 1588161c58..4f1351bccb 100644
--- a/liblinphone/coreapi/lpc2xml.c
+++ b/liblinphone/coreapi/lpc2xml.c
@@ -98,7 +98,12 @@ static int processEntry(const char *section, const char *entry, xmlNode *node, l
 		lpc2xml_log(ctx, LPC2XML_ERROR, "Issue when reading the lpc");
 		return -1;
 	}
-	lpc2xml_log(ctx, LPC2XML_MESSAGE, "Set %s|%s = %s", section, entry, content);
+	/* Gastecom (2026-10-14): no escribir secretos en el log (ver xml2lpc.c). */
+	lpc2xml_log(ctx, LPC2XML_MESSAGE, "Set %s|%s = %s", section, entry,
+	            (strstr(entry, "passwd") || strstr(entry, "password") || strcmp(entry, "ha1") == 0 ||
+	             strcmp(entry, "config-uri") == 0)
+	                ? "***"
+	                : content);
 
 	// xmlNodeSetContent expects special characters to be escaped, xmlNodeAddContent doesn't (and escapes what needs
 	// to be)
diff --git a/liblinphone/coreapi/xml2lpc.c b/liblinphone/coreapi/xml2lpc.c
index 2f4935a049..c0375c958b 100644
--- a/liblinphone/coreapi/xml2lpc.c
+++ b/liblinphone/coreapi/xml2lpc.c
@@ -129,6 +129,17 @@ static void dumpContent(xmlNode *node, xml2lpc_context *ctx) {
 	else xml2lpc_log(ctx, XML2LPC_DEBUG, "content: ");
 }
 
+/* Gastecom (2026-10-14): no escribir secretos en el log. El XML de
+ * aprovisionamiento trae la contrasena SIP (passwd/ha1), la de la agenda LDAP
+ * (password) y config-uri (con el token que da acceso a todo lo anterior), y
+ * esta funcion los volcaba en claro en cada arranque/reaprovisionamiento. */
+static const char *gastecom_log_value(const char *name, const char *value) {
+	if (name && (strstr(name, "passwd") || strstr(name, "password") || strcmp(name, "ha1") == 0 ||
+	             strcmp(name, "config-uri") == 0))
+		return "***";
+	return value;
+}
+
 static int processEntry(xmlElement *element, const char *sectionName, xml2lpc_context *ctx) {
 	xmlNode *cur_attr = NULL;
 	const char *name = NULL;
@@ -146,17 +157,19 @@ static int processEntry(xmlElement *element, const char *sectionName, xml2lpc_co
 		}
 	}
 
-	dumpContent((xmlNode *)element, ctx);
+	if (strcmp(gastecom_log_value(name, ""), "***") != 0) dumpContent((xmlNode *)element, ctx);
 	if (element->children) value = (const char *)element->children->content;
 	else value = "";
 
 	if (name != NULL) {
 		const char *str = linphone_config_get_string(ctx->lpc, sectionName, name, NULL);
 		if (str == NULL || overwrite) {
-			xml2lpc_log(ctx, XML2LPC_MESSAGE, "Set %s|%s = %s", sectionName, name, value);
+			xml2lpc_log(ctx, XML2LPC_MESSAGE, "Set %s|%s = %s", sectionName, name,
+			            gastecom_log_value(name, value));
 			linphone_config_set_string(ctx->lpc, sectionName, name, value);
 		} else {
-			xml2lpc_log(ctx, XML2LPC_MESSAGE, "Don't touch %s|%s = %s", sectionName, name, str);
+			xml2lpc_log(ctx, XML2LPC_MESSAGE, "Don't touch %s|%s = %s", sectionName, name,
+			            gastecom_log_value(name, str));
 		}
 	} else {
 		xml2lpc_log(ctx, XML2LPC_WARNING, "ignored entry with no \"name\" attribute line:%d",
diff --git a/liblinphone/src/ldap/ldap-contact-provider.cpp b/liblinphone/src/ldap/ldap-contact-provider.cpp
