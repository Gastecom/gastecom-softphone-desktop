+						std::shared_ptr<Friend> lFriend = Friend::create(mCore);
+						lFriend->setName(ldapData.mName.first);
 						for (auto sipAddress : ldapData.mSip) {
 							std::shared_ptr<Address> addr = mCore->interpretUrl(sipAddress.first, false);
 							if (addr) {
